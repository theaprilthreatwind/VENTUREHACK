# Скопируйте этот файл в .env.local (он в .gitignore) и меняйте значения.
# Next.js читает env-файлы по режиму: .env.local — все режимы,
# .env.development — только `next dev`, .env.production — только прод-сборка.

# Базовый URL backend. Порт Spring Boot по умолчанию — 8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Источник данных:
#   true  — mockApiService (данные из src/shared/api/mock/fixtures.js)
#   false — реальный backend по NEXT_PUBLIC_API_URL
# Если не задано: mock в development, backend в production.
# Раскомментируйте, чтобы переопределить поведение по умолчанию:
# NEXT_PUBLIC_USE_MOCKS=true
